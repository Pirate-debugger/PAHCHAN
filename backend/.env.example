# ==============================================================================
# PAHCHAN — AI Fake Identity & Document Screening System (SIH2026188)
# Backend Environment Configuration Example
# ==============================================================================

# Core Application Settings
PROJECT_NAME="PAHCHAN — AI Fake Identity & Document Screening System"
VERSION="1.0.0"
ORGANIZATION="Ministry of Home Affairs / Sashastra Seema Bal (SSB)"
DEPARTMENT="Police II Division"
SIH_PROBLEM_ID="SIH2026188"
API_V1_STR="/api"

# Database Configuration (SQLite default for zero-setup local operation)
DATABASE_URL="sqlite:///./pahchan.db"

# Security & CORS Whitelist (Comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000"

# Document Upload Limits & Constraints
MAX_UPLOAD_SIZE_MB=15

# Risk Engine Thresholds (0 - 100 scale)
RISK_THRESHOLD_LOW=29
RISK_THRESHOLD_REVIEW=59
RISK_THRESHOLD_HIGH=79

# Quality Guard Thresholds
MIN_FACE_SHARPNESS_VAR=35.0
MIN_FACE_CONFIDENCE=0.60

# Demonstration & Evaluation Mode Toggles
ENABLE_DEMO_WATCHLIST=true
DEMO_WATCHLIST_NAME="Demonstration Verification Source"
ALLOW_DEMO_PROVIDERS=true

# Authoritative Government Provider Gateway Credentials (Optional: Leave empty for Sandbox / Demo mode)
# PAN / NSDL Gateway
PAN_API_KEY=""
INCOME_TAX_API_KEY=""

# Passport Seva / MEA Gateway
PASSPORT_SEVA_API_KEY=""

# MoRTH / Parivahan Sarathi Gateway
PARIVAHAN_API_KEY=""

# DigiLocker / API Setu OAuth2 Credentials
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
